{
  "manifest_version": 3,
  "name": "WhiteTab 新标签页",
  "version": "2.0.0",
  "description": "液态玻璃风格的新标签页，每次打开焕然一新的色彩。支持自定义搜索引擎与快捷入口，含联想词建议与深浅主题。",
  "icons": {
    "128": "resources/favicon.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "permissions": [],
  "host_permissions": [
    "https://suggestion.baidu.com/*",
    "https://api.bing.com/*",
    "https://suggestqueries.google.com/*"
  ]
}
